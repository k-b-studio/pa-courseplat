# PA CoursePlat — every variable the app and scripts read. Copy to .env and fill in.
# Never commit .env. Secrets live only in .env (and Vercel's environment settings).

# Supabase (project shared with creditGPAX; URL and publishable key are the same as creditGPAX's)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server + scripts only (Dashboard → Project Settings → API Keys → Secret keys)
SUPABASE_SECRET_KEY=
# scripts and tests only: db:migrate, db:snapshot, seed, test:db, test:e2e. Session pooler (IPv4 and IPv6):
# postgresql://postgres.<project-ref>:<url-encoded password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Google Gemini API, free tier (Google AI Studio, project pa-courseplat-1) — reads documents
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# free = show the free-tier data notice on the import page; paid = hide it
AI_TIER=free
AI_MAX_CALLS_PER_HOUR=6

# ThaiLLM (thaillm.or.th, NSTDA) — judges Content Caution pairs; HTTPS only
THAILLM_API_KEY=
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
THAILLM_MODEL=openthaigpt

# routing: who judges caution pairs (thaillm|gemini); text-extraction fallback (thaillm|none)
AI_CAUTION_PROVIDER=thaillm
AI_EXTRACT_FALLBACK=thaillm

# true = never call an AI service; use fixtures/ (every demo path still works)
AI_OFFLINE=false

# demo mode: demo sign-in buttons and the demo-data badge
PUBLIC_DEMO_MODE=true
# shared password of the seeded demo accounts (server + scripts only)
DEMO_ACCOUNT_PASSWORD=
